
# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://localhost:27017/scribbleverse

# Port the HTTP + Socket.IO server listens on
PORT=4000

# Exact origin the frontend is served from (used for CORS + Socket.IO)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign auth JWTs. Generate a real random value for any real
# deployment, e.g.: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# If unset, the server falls back to an insecure development-only secret and
# prints a warning on startup — never rely on that fallback outside local dev.
JWT_SECRET=

# Set to "production" when deployed — makes the auth cookie Secure + SameSite=None
NODE_ENV=development
